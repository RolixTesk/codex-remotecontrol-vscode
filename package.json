{
  "name": "codex-live-remote",
  "displayName": "Codex Live Remote",
  "description": "Use ChatGPT mobile to remotely control Codex in VS Code.",
  "version": "0.1.10",
  "publisher": "RolixTesk",
  "author": {
    "name": "RolixTesk",
    "url": "https://github.com/RolixTesk"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/RolixTesk/codex-remotecontrol-vscode.git"
  },
  "homepage": "https://github.com/RolixTesk/codex-remotecontrol-vscode/blob/master/README.md",
  "bugs": {
    "url": "https://github.com/RolixTesk/codex-remotecontrol-vscode/issues"
  },
  "keywords": [
    "codex",
    "chatgpt",
    "remote-control",
    "wsl",
    "ubuntu"
  ],
  "engines": {
    "vscode": "^1.118.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./extension/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    },
    "virtualWorkspaces": false
  },
  "contributes": {
    "commands": [
      {
        "command": "codexRemote.enable",
        "title": "配置远程控制",
        "category": "Codex Remote"
      },
      {
        "command": "codexRemote.connect",
        "title": "启动远程控制",
        "category": "Codex Remote"
      },
      {
        "command": "codexRemote.pair",
        "title": "配对手机",
        "category": "Codex Remote"
      },
      {
        "command": "codexRemote.status",
        "title": "查看远程控制状态",
        "category": "Codex Remote"
      },
      {
        "command": "codexRemote.disconnect",
        "title": "停止远程控制",
        "category": "Codex Remote"
      },
      {
        "command": "codexRemote.restore",
        "title": "恢复 Codex 启动设置（卸载前）",
        "category": "Codex Remote"
      }
    ]
  },
  "scripts": {
    "package": "vsce package --out dist/codex-live-remote-0.1.10.vsix --githubBranch master --no-dependencies && python3 tests/check_vsix.py"
  },
  "license": "SEE LICENSE IN LICENSE.txt",
  "private": true,
  "devDependencies": {
    "@vscode/vsce": "4.0.0"
  }
}

{
  "name": "codex-live-remote",
  "displayName": "Codex Live Remote",
  "description": "Use ChatGPT mobile to remotely control Codex in VS Code.",
  "version": "0.1.7",
  "publisher": "rolix",
  "engines": {
    "vscode": "^1.140.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./extension/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    },
    "virtualWorkspaces": false
  },
  "contributes": {
    "commands": [
      {
        "command": "codexRemote.enable",
        "title": "配置远程控制",
        "category": "Codex Remote"
      },
      {
        "command": "codexRemote.connect",
        "title": "启动远程控制",
        "category": "Codex Remote"
      },
      {
        "command": "codexRemote.pair",
        "title": "配对手机",
        "category": "Codex Remote"
      },
      {
        "command": "codexRemote.status",
        "title": "查看远程控制状态",
        "category": "Codex Remote"
      },
      {
        "command": "codexRemote.disconnect",
        "title": "停止远程控制",
        "category": "Codex Remote"
      },
      {
        "command": "codexRemote.restore",
        "title": "恢复 Codex 启动设置（卸载前）",
        "category": "Codex Remote"
      }
    ]
  },
  "scripts": {
    "package": "vsce package --out dist/codex-live-remote-0.1.7.vsix --allow-missing-repository --no-rewrite-relative-links --skip-license --no-dependencies && python3 tests/check_vsix.py"
  },
  "license": "UNLICENSED",
  "private": true,
  "devDependencies": {
    "@vscode/vsce": "4.0.0"
  }
}
